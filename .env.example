# Copy this file to .env for local runs (never commit the real .env).
# In GitHub Actions, these are set as repository Secrets instead (Settings > Secrets and variables > Actions).

# Groq free-tier API key — https://console.groq.com/keys
GROQ_API_KEY=

# GitHub personal access token (free) — used only to raise the GitHub API rate limit
# (60/hr unauthenticated -> 5000/hr authenticated). No special scopes needed for public repo reads.
GH_API_TOKEN=

# Reddit API app (free) — https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=shahbaz-daily-updates/0.1 by u/yourusername

# Firebase service account JSON, either:
#  - path to a local file, e.g. ./firebase-service-account.json (local dev), or
#  - the raw JSON contents (GitHub Actions secret)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
